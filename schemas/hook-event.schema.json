{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://verificar-mudancas.local/schemas/hook-event.schema.json",
  "type":"object",
  "required":["event","status","block","messages"],
  "properties":{
    "event":{"enum":["pre-edit","post-edit","pre-finish"]},
    "status":{"enum":["PASS","WARN","BLOCKED","VERIFICATION_INCOMPLETE"]},
    "block":{"type":"boolean"},
    "messages":{"type":"array","items":{"type":"string"}},
    "details":{"type":"object"}
  },
  "additionalProperties":false
}
