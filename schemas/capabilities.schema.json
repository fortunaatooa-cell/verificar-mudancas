{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://verificar-mudancas.local/schemas/capabilities.schema.json",
  "type":"object",
  "required":["adapter","version","capabilities","command_strategy"],
  "properties":{
    "adapter":{"type":"string","minLength":1},
    "version":{"type":"integer","minimum":1},
    "capabilities":{"type":"object","additionalProperties":{"enum":["native","emulated","runtime-detect","unsupported"]}},
    "command_strategy":{"enum":["native","staged-prompts","portable-files"]}
  },
  "additionalProperties":false
}
