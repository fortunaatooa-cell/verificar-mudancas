{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://verificar-mudancas.local/schemas/pattern.schema.json",
  "type":"object",
  "required":["id","kind","title","signals","guidance","evidence_refs","privacy"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "kind":{"const":"pattern"},
    "title":{"type":"string","minLength":1},
    "signals":{"type":"array","minItems":1,"items":{"type":"string"}},
    "guidance":{"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "privacy":{"type":"object","required":["sanitized"],"properties":{"sanitized":{"const":true}}}
  },
  "additionalProperties":true
}
