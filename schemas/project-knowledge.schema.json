{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://verificar-mudancas.local/schemas/project-knowledge.schema.json",
  "type":"object",
  "required":["id","kind","context","facts","source","privacy"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "kind":{"const":"project_knowledge"},
    "context":{"type":"object"},
    "facts":{"type":"array","minItems":1,"items":{"type":"string"}},
    "source":{"type":"string","minLength":1},
    "privacy":{"type":"object","required":["sanitized"],"properties":{"sanitized":{"const":true}}}
  },
  "additionalProperties":true
}
