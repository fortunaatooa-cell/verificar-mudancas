{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verificar-mudancas.dev/schemas/task.schema.json",
  "title": "Tarefa Verificar Mudanças",
  "type": "object",
  "required": ["tipo", "objetivo", "risco", "aceite", "agentes"],
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["bug", "feature", "refatoracao", "migracao", "incidente", "upgrade-dependencia", "regressao-performance", "dados", "infraestrutura", "investigacao", "revisao"]
    },
    "objetivo": {"type": "string", "minLength": 1},
    "ambiente": {
      "type": "object",
      "properties": {
        "stack": {"type": "array", "items": {"type": "string"}},
        "infraestrutura": {"type": "array", "items": {"type": "string"}},
        "versao": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "risco": {
      "type": "object",
      "required": ["nivel", "motivos"],
      "properties": {
        "nivel": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "motivos": {"type": "array", "items": {"type": "string"}}
      }
    },
    "aceite": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "agentes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["investigador", "diagnosticador-runtime", "estrategista-testes", "implementador", "revisor-codigo", "revisor-seguranca", "verificador-evidencias"]
      }
    },
    "lacunas": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
