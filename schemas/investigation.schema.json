{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verificar-mudancas.dev/schemas/investigation.schema.json",
  "title": "Resultado de Investigação",
  "type": "object",
  "required": ["fatos", "hipoteses", "hipoteses_rejeitadas", "lacunas"],
  "properties": {
    "fatos": {"type": "array", "items": {"type": "string"}},
    "hipoteses": {"type": "array", "items": {"type": "string"}},
    "hipoteses_rejeitadas": {"type": "array", "items": {"type": "string"}},
    "hipotese_mais_forte": {"type": ["string", "null"]},
    "evidencias_favoraveis": {"type": "array", "items": {"type": "string"}},
    "evidencias_contrarias": {"type": "array", "items": {"type": "string"}},
    "proximo_experimento": {"type": ["string", "null"]},
    "lacunas": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
