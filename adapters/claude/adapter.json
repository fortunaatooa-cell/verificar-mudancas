{
  "adapter": "claude",
  "version": 1,
  "capabilities": {
    "repository_read": "runtime-detect",
    "repository_write": "runtime-detect",
    "shell": "runtime-detect",
    "web": "runtime-detect",
    "subagents": "runtime-detect",
    "hooks": "runtime-detect",
    "persistent_memory": "runtime-detect",
    "external_tools": "runtime-detect",
    "vision_input": "runtime-detect",
    "visual_generation": "runtime-detect"
  },
  "command_strategy": "native",
  "native": {
    "project_memory": "CLAUDE.md",
    "skills": ".claude/skills",
